# BlaBla + Porter Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# PostgreSQL Database
DATABASE_URL=jdbc:postgresql://localhost:5432/blabla_porter
DATABASE_USERNAME=blabla
DATABASE_PASSWORD=blabla_secret

# JWT Signing Secret (generate a random 64+ character alphanumeric string)
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS_LONG

# Seed data on startup (set to false after first boot)
BLABLA_SEEDER_ENABLED=true
